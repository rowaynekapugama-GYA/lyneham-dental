# Set these in Vercel: Project Settings, Environment Variables (Production and Preview).
# Never commit real values.

# SMTP2GO API key for the practice's own SMTP2GO account (contact form)
SMTP2GO_API_KEY=
# From-address on a domain verified in SMTP2GO
SENDER_EMAIL=Lyneham Dental Care <website@lynehamdentalcare.com.au>
# Comma-separated enquiry recipients (falls back to admin@ and rowayne@gyaclients.com if unset)
ENQUIRY_TO=admin@lynehamdentalcare.com.au,rowayne@gyaclients.com
